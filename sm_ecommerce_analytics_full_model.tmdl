				formatString: 0
				lineageTag: c50e8016-ce1e-401c-bd5f-34581dece4fb

				changedProperty = Name

			measure Orders_with_items = DISTINCTCOUNT('fact_order_items'[order_id])
				formatString: 0
				lineageTag: 1ae017ba-ebf4-46ee-adb4-f3a50a0da84f

				changedProperty = Name

			measure Item_sold = SUM('fact_order_items'[item_count])
				formatString: 0
				lineageTag: 25529b92-eaf9-4bef-af0b-412aa9392307

				changedProperty = Name

			measure 'Average Item Price' = DIVIDE([product_revenue], [Item_sold])
				formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
