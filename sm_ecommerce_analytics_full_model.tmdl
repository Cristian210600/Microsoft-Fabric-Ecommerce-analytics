		table data_quality_results
			lineageTag: b4cdfcf8-fdf0-4b3c-a85e-c31fde5f3d82
			sourceLineageTag: [audit].[data_quality_results]

			measure 'DQ Passed Checks Latest' =
					
					CALCULATE(
					    [DQ Total Checks Latest],
					    'data_quality_results'[status] = "PASS"
					)
				formatString: 0
				lineageTag: 6e2700cd-4b6c-4101-b27d-32e19261a434

				changedProperty = Name

			measure 'DQ Failed Checks Latest' =
					
					CALCULATE(
					    [DQ Total Checks Latest],
					    'data_quality_results'[status] = "FAIL"
					)
				formatString: 0
				lineageTag: 13540982-c0c5-41ee-ac3d-6838b17d2659

				changedProperty = Name

			measure 'DQ Failed Rows' =
					VAR LatestRunID =
					    MAXX(
					        TOPN(
					            1,
					            ALL('data_quality_results'),
					            'data_quality_results'[execution_timestamp], DESC
					        ),
					        'data_quality_results'[run_id]
					    )
					RETURN
					    CALCULATE(
					        SUM('data_quality_results'[failed_rows]),
					        'data_quality_results'[run_id] = LatestRunID
					    )
				formatString: 0
				lineageTag: 7fa230d5-215b-4569-8471-085998024bea

				changedProperty = Name

			measure 'DQ Latest Execution' =
					
					CALCULATE(
					    MAX('data_quality_results'[execution_timestamp]),
					    REMOVEFILTERS('data_quality_results')
					)
				formatString: General Date
				lineageTag: 7f418c75-97f7-4607-abbf-3de9710c5b4f

				changedProperty = Name

			measure 'DQ Tables Checked Latest' =
					
					SUMX(
					    VALUES('data_quality_results'[table_name]),
					
					    VAR LatestExecutionForTable =
					        CALCULATE(
					            MAX('data_quality_results'[execution_timestamp]),
					            ALLEXCEPT(
					                'data_quality_results',
					                'data_quality_results'[table_name]
					            )
					        )
					
					    VAR ChecksInLatestExecution =
					        CALCULATE(
					            COUNTROWS('data_quality_results'),
					            ALLEXCEPT(
					                'data_quality_results',
					                'data_quality_results'[table_name]
					            ),
					            'data_quality_results'[execution_timestamp]
					                = LatestExecutionForTable
					        )
					
					    RETURN
					        IF(ChecksInLatestExecution > 0, 1, 0)
					)
				formatString: 0
				lineageTag: 8153d5a7-b5e9-4b67-9941-15eecc4dfc5e

				changedProperty = Name

			measure 'DQ Latest Run Rows' = VAR LatestRunId = MAXX(TOPN(1, ALL('data_quality_results'), 'data_quality_results'[execution_timestamp], DESC), 'data_quality_results'[rule_id])  RETURN CALCULATE(COUNTROWS('data_quality_results'), 'data_quality_results'[run_id] = LatestRunId)
				formatString: 0
				lineageTag: d5748812-8ad5-4c29-b3f7-c6ddda8d210e

				changedProperty = Name

			measure product_revenue_previous_year =
					
					CALCULATE(
					    [product_revenue],
					    DATEADD(
					        'dim_date'[date],
					        -1,
					        YEAR
					    )
					)
				formatString: 0
				lineageTag: 3d7b993a-3165-4b7d-bd3e-18bd4326c360

				changedProperty = Name

			measure product_revenue_yoy_pct =
					DIVIDE(
					    [product_revenue] - [product_revenue_previous_year],
					    [product_revenue_previous_year]
					)
				formatString: "£"#,0.###############;-"£"#,0.###############;"£"#,0.###############
				lineageTag: 37de6c79-fd9f-4d1f-8d02-d909ce7c3d10

				changedProperty = Name

				annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

			measure product_revenue_trend =
					VAR change_pct = [product_revenue_yoy_pct]
					
					RETURN
					    SWITCH(
					        TRUE(),
					        ISBLANK(change_pct), "—",
					        change_pct > 0, "▲ " & FORMAT(change_pct, "0.0%"),
					        change_pct < 0, "▼ " & FORMAT(ABS(change_pct), "0.0%"),
					        "● 0.0%"
					    )
				lineageTag: 26e54a0f-87bf-4ccc-95c7-bd3dc2acaa86

				changedProperty = Name

			measure 'Test Customer ID' =
					
					DISTINCTCOUNT(dim_customer[customer_id])
				formatString: 0
				lineageTag: a53f0192-619d-49ff-8ee5-38d409b6d919

				changedProperty = Name

			measure 'Total Customers' =
					
					DISTINCTCOUNT(dim_customer[customer_unique_id])
				formatString: 0
				lineageTag: 094c00ef-10e0-452c-bf81-9066977092f3

				changedProperty = Name

			measure 'Positive reviews' = CALCULATE([total_reviews], fact_order_reviews[review_score] >=4)
				formatString: 0
				lineageTag: 9cdd305b-2a9c-49f0-93bf-fb7e1008866b

				changedProperty = Name

			measure 'positive reviews rate' = DIVIDE([Positive reviews], [total_reviews], 0)
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: 211720ef-7931-48a8-aea4-62b0f5982862

				changedProperty = Name

				changedProperty = FormatString

			measure 'Negative reviews' = CALCULATE([total_reviews], fact_order_reviews[review_score] <=2)
				formatString: 0
				lineageTag: 64f20879-3f89-4df0-9579-0f41e3351905

				changedProperty = Name

			measure 'negative rate' = DIVIDE([Negative reviews], [total_reviews], 0)
				lineageTag: 72fee2c8-e211-4f44-9e73-f278446b5c00

				changedProperty = Name

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'DQ Total Checks Latest' =
					
					SUMX(
					    VALUES('data_quality_results'[table_name]),
					
					    VAR LatestExecutionForTable =
					        CALCULATE(
					            MAX('data_quality_results'[execution_timestamp]),
					            ALLEXCEPT(
					                'data_quality_results',
					                'data_quality_results'[table_name]
					            )
					        )
					
					    RETURN
					        CALCULATE(
					            COUNTROWS('data_quality_results'),
					            'data_quality_results'[execution_timestamp]
					                = LatestExecutionForTable
					        )
					)
				formatString: 0
				lineageTag: 0f06da46-ecc3-4970-8627-117bddd7ff27

				changedProperty = Name

			measure 'DQ Warning Checks Latest' =
					
					CALCULATE(
					    [DQ Total Checks Latest],
					    'data_quality_results'[status] = "WARNING"
					)
				formatString: 0
				lineageTag: 6097afe5-d55d-42f4-808b-35b8b715c447

				changedProperty = Name

			measure 'DQ Pass Rate Latest' =
					
					DIVIDE(
					    [DQ Passed Checks Latest],
					    CALCULATE(
					        [DQ Total Checks Latest],
					        REMOVEFILTERS('data_quality_results'[status])
					    ),
					    0
					)
				lineageTag: a88afbfa-8b3f-46f4-9dbb-bf16ec0d369e

				changedProperty = Name

