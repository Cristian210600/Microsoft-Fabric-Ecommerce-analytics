		table fact_order_items
			lineageTag: ae7bb9ce-c6f7-43da-9b48-70e39025347a
			sourceLineageTag: [gold].[fact_order_items]

			measure product_revenue = SUM(fact_order_items[item_price])
				formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
				lineageTag: 0596c578-db59-4c53-842f-e0c64e9b2371

				changedProperty = Name

				changedProperty = FormatString

				annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

			measure total_freight_value = SUM((fact_order_items[freight_value]))
				formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
				lineageTag: a4f1da70-38a5-4aac-830c-21c1edfb8d2b

				changedProperty = Name

				changedProperty = FormatString

				annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

			measure gross_merchandise_value = [product_revenue] + [total_freight_value]
				formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
				lineageTag: a9b53de1-75d7-4c0f-b5bf-def0671ae4e0

				changedProperty = Name

				changedProperty = FormatString

				annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

