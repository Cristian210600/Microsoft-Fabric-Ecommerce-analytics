		table fact_orders
			lineageTag: 66a1cea8-e8d2-44fc-9e6f-a97f161a984d
			sourceLineageTag: [gold].[fact_orders]

			measure total_orders = DISTINCTCOUNT(fact_orders[order_id])
				formatString: 0
				lineageTag: 0f5e4ab2-83e1-4e04-940e-c72a42575e55

				changedProperty = Name

			measure delivered_orders = CALCULATE([total_orders], fact_orders[order_status] = "delivered")
				formatString: 0
				lineageTag: c3a198b6-00e5-4c2b-af9b-e353f52dd8df

				changedProperty = Name

			measure delivery_rate = DIVIDE([delivered_orders], [total_orders], 0)
				formatString: #,0.00%;-#,0.00%;#,0.00%
				lineageTag: 705b69f5-89d7-4bae-af60-24d0db2b855a

				changedProperty = Name

				changedProperty = FormatString

			measure canceled_orders = CALCULATE([total_orders], fact_orders[order_status] = "canceled")
				formatString: 0
				lineageTag: 7a15b215-a949-4a0d-9a71-79b6a8438328

				changedProperty = Name

			measure orders_approval_date = CALCULATE([total_orders], USERELATIONSHIP(fact_orders[approved_date_key], dim_date[date_key]))
				formatString: 0
				lineageTag: 26402c61-d52f-40cf-a0e6-8efd9994c53d

				changedProperty = Name

			measure orders_carrier_date = CALCULATE([total_orders], USERELATIONSHIP(fact_orders[carrier_date_key], dim_date[date_key]))
				formatString: 0
				lineageTag: 7923513e-5dc3-4352-9b0a-bdea3c1f475e

				changedProperty = Name

			measure orders_delivery_date = CALCULATE([total_orders], USERELATIONSHIP(fact_orders[delivered_date_key], dim_date[date_key]))
				formatString: 0
				lineageTag: a62325ae-9516-4efd-848c-7854195168b4

				changedProperty = Name

			measure orders_estimated_delivery_date = CALCULATE([total_orders], USERELATIONSHIP(fact_orders[estimated_delivery_date_key], dim_date[date_key]))
				formatString: 0
				lineageTag: 79cdbc03-b151-4efc-98f7-6e8bad12e090

				changedProperty = Name

			measure Late_orders =
					
					CALCULATE(
					    [total_orders],
					    'fact_orders'[is_late_delivery] = TRUE()
					)
				formatString: 0
				lineageTag: b82c44ca-1f11-47e8-856f-d1f7f827cac8

				changedProperty = Name

			measure Late_delivery_rate = DIVIDE([Late_orders], [delivered_orders])
