		table dim_customer
			lineageTag: f00f4def-3c0c-46cd-926b-5e11cc748fe7
			sourceLineageTag: [gold].[dim_customer]

			measure revenue_previous_month = CALCULATE([product_revenue], DATEADD('dim_date'[date], -1, MONTH))
				formatString: "£"#,0.###############;-"£"#,0.###############;"£"#,0.###############
				lineageTag: 9d6683c7-924d-4ce9-9ca4-bfcbe1e99024

				changedProperty = Name

				annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

			measure 'Revenue MoM %' = DIVIDE([product_revenue]-[revenue_previous_month], [revenue_previous_month])
				lineageTag: f8aaf970-3176-4687-b523-26d2a8d63db9

				changedProperty = Name

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure orders_per_customer = DIVIDE([total_orders], [Total Customers])
				lineageTag: b84979de-6cd3-44c9-8b65-67c6d87b3da7

				changedProperty = Name

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure repeat_customers = COUNTROWS(FILTER(VALUES('dim_customer'[customer_unique_id]), CALCULATE([total_orders])>1))
				formatString: 0
				lineageTag: f50a0d79-31a0-45b7-96c3-44e740a5f188

				changedProperty = Name

			measure Repeat_customer_rate = DIVIDE([repeat_customers], [Total Customers], 9)
				formatString: 0.00%;-0.00%;0.00%
				lineageTag: c5034c0e-00d2-406f-b527-f815c09bec95

				changedProperty = Name

				changedProperty = FormatString

			measure total_sellers = DISTINCTCOUNT('fact_order_items'[seller_id])
				formatString: 0
				lineageTag: e7c2a8a2-6f37-4ab0-bb99-61db7e7246a2

				changedProperty = Name

			measure revenue_per_seller = DIVIDE([product_revenue], [total_sellers])
				formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
				lineageTag: 8fe4c1ae-60c9-4e31-97e5-cb1cb157319e

